{
  "name": "expo-video-encoder",
  "version": "1.2.0",
  "description": "Turn JPEG frames into an H.264 MP4 in Expo and React Native, using AVFoundation on iOS and MediaCodec on Android, with iOS audio mixing. No external dependencies.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "ios",
    "android",
    "src",
    "ExpoVideoEncoder.podspec",
    "expo-module.config.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!android/build",
    "!android/.gradle",
    "!android/.cxx",
    "!ios/build"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('build', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "package:check": "npm run typecheck && npm run build && npm test && node scripts/verify-package.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "expo",
    "expo-module",
    "react-native",
    "video",
    "video-encoder",
    "video-export",
    "mp4",
    "h264",
    "encoder",
    "avfoundation",
    "mediacodec",
    "ios",
    "android",
    "frames",
    "jpeg",
    "image-sequence",
    "frames-to-video",
    "skia",
    "audio-mixing",
    "ffmpeg-alternative",
    "ffmpeg-kit-alternative"
  ],
  "author": "AJIBADE HAMMED ADEDAPO <ajibadehammed@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajibadedapo/expo-video-encoder.git"
  },
  "bugs": {
    "url": "https://github.com/ajibadedapo/expo-video-encoder/issues"
  },
  "homepage": "https://github.com/ajibadedapo/expo-video-encoder#readme",
  "peerDependencies": {
    "expo": ">=51.0.0",
    "react-native": ">=0.74.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-native": "^0.73.0",
    "expo-modules-core": "^57.0.16",
    "typescript": "~7.0.2"
  }
}
