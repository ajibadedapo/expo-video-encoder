{
  "compilerOptions": {
    "target": "ES2018",
    "module": "node16",
    "lib": ["ES2018"],
    "outDir": "build",
    "rootDir": "src",
    "declaration": true,
    "strict": true,
    "moduleResolution": "node16",
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "build"]
}
